  <link rel="preload" href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.css" as="style">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.8.1/slick.js" defer="defer"></script>
<script>
$(document).ready(function(){
  $("body").addClass('affilate-page');
  $(".accordion li .data").not(".accordion li.active .data").hide();
  $(".accordion li h3").click(function () {
    if ($(this).parent().hasClass("active")) {
      $(this).parent().removeClass("active").find(".data").slideUp();
    } else {
      $(".accordion li.active .data").slideUp();
      $(".accordion li.active").removeClass("active");
      $(this).parent().addClass("active").find(".data").slideDown();
    }
    return false;
  });

  $(document).ready(function(){
   $('.our-value ul').slick({
		arrows:true,
        dots:false,
		infinite: true,
		speed: 300,
		slidesToShow: 1,
		slidesToScroll: 1,
        centerMode: true,
        centerPadding: '25%',
        
     responsive: [
    {
      breakpoint: 1023,
      settings: {
        centerPadding: '10%',
      }
    },
    {
      breakpoint: 640,
      settings: {
        centerPadding: '0',
      }
    },
  ]
	});
    return false;
  });
});
  
</script>
