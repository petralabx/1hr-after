<div class="">
  {% if section.settings.display_top_content %}
  <div class="top-content">
  {% if section.settings.top_heading != '' or section.settings.top_subheading %}
    <div class="heading">
      {% if section.settings.top_heading != '' %}
      <h2>{{section.settings.top_heading}}</h2>
      {% endif %}
      {% if section.settings.top_subheading != '' %}
      <p>{{section.settings.top_subheading}}</p>
      {% endif %}
    </div>
  {% endif %}
     {% assign srNobanner = 0 %}
    {% for block in section.blocks %}
    {% assign srNobanner = srNobanner | plus: 1 %}
    {% if block.type == 'top_content' %}
    <div class="row content-item custom-about banner-seq-{{srNobanner}} {% if block.settings.alignment == 'left' %}reserve{% endif %}">
       {% assign slick = 0 %}
        {% for i in (1..5) %}
        {% capture title %}title_{{i}}{% endcapture %}
        {% capture content %}content_{{i}}{% endcapture %}
        {%if block.settings[title] != blank or block.settings[content] != blank %}
        {% assign slick = slick | plus: 1 %}
        <div class="text-item about-text-left {%if slick == 2 %}init-slide{%endif%}">
          <div class="inner">
             {% if block.settings.block.settings[title] != '' %}
            {{block.settings[title]}}
            
            {% endif %}
            <div class="content">
              {{block.settings[content]}}
            </div>
          </div>
        </div>
      
      {% if block.settings.display_banner %}
      <div class="col banner about-image-right {% if block.settings.banner == blank %}no-image{% endif %}" >
        {% if block.settings.banner != blank %}
        <img src="{{block.settings.banner | img_url:'800x800'}}" />
        {% else %}
        <div class="placeholder-background">
            <span class="recommended_size">800x800</span>
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
        {% endif %}
      </div>
      {% endif %}
      
       
        {% endif %}
        {% endfor %}
      </div>
   
    {% endif %}
    {% endfor %}
  </div>
  {% endif %}
  
</div>


