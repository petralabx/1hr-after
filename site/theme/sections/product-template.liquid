  const proxyURL = "https://dev.maxdigi.co/proxy/1hra.php/";
  const apiToken = "6hK13i9DIMMpUQJUM0cFQAYhChM";
  const shopDomain = "1hourafter.myshopify.com";
  const productExternalId = "{{ product.id }}"; // Replace with dynamic product ID from Shopify

  // Get internal product ID based on external ID
  function getInternalProductId(externalId) {
    const url = `${proxyURL}https://api.judge.me/api/v1/products/?api_token=${apiToken}&shop_domain=${shopDomain}&per_page=10000`;
    return fetch(url)
      .then(response => {
        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
        return response.json();
      })
      .then(data => {
        const matchedProduct = data.products.find(p => p.external_id == externalId);
        return matchedProduct ? matchedProduct.id : null;
      });
  }

  // Fetch and render reviews for a given internal product ID
  function fetchAndDisplayReviews(productId, externalId) {
    const url = `${proxyURL}https://api.judge.me/api/v1/reviews/?api_token=${apiToken}&shop_domain=${shopDomain}&product_id=${productId}`;

    return fetch(url)
      .then(response => {
        if (!response.ok) throw new Error(`HTTP error! Status: ${response.status}`);
        return response.json();
      })
      .then(data => {
        const reviews = data.reviews || [];
        const testimonialList = document.getElementById("testimonial-list");
        testimonialList.innerHTML = "";


        const filtered = reviews.filter(
          review => review.product_external_id === externalId && review.published === true
        );
        reviews.sort((a, b) => {
          if (a.featured && !b.featured) return -1;
          if (!a.featured && b.featured) return 1;
          return new Date(b.created_at) - new Date(a.created_at);
        });

        const latest = reviews.slice(0, 4);
        if (latest.length === 0) {
          testimonialList.innerHTML = "<p>No reviews found for this product.</p>";
        } else {
          latest.forEach(review => {
            const listItem = document.createElement("li");
            listItem.innerHTML = `
              <div class="content-wrap">
                <h4>${review.title || ""}</h4>
                <p>${review.body}</p>
                <div class="stars">
                  ${Array.from({ length: 5 }, (_, i) =>
              i < review.rating ? `<span class="star filled">★</span>` : `<span class="star">☆</span>`
            ).join("")}
                </div>
                <h6>${review.reviewer.name}</h6>
              </div>
            `;
            testimonialList.appendChild(listItem);
          });
        }
      });
  }

  // Main runner
  function loadProductReviews() {
    getInternalProductId(productExternalId)
      .then(productId => {
        if (!productId) {
          throw new Error("Product not found");
        }
        return fetchAndDisplayReviews(productId, productExternalId);
      })
      .catch(error => {
        console.error("Error:", error.message);
      });
  }

  $('document').ready(function () {
    loadProductReviews();
  })




