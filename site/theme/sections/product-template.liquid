<script>
  $(document).ready(function(){

    
    //alert('hii');
 setTimeout(function() {
    $('.jdgm-widget-actions-wrapper a.jdgm-write-rev-link').show();
    $('.jdgm-widget-actions-wrapper a.jdgm-write-rev-link').on('click',function(){
        setTimeout(function(){
            $('div.jdgm-form-wrapper').show()
        },500)
    });
}, 1000);

    if($(".product-media-wrap .slick-slide div").css("height: 100%")){ alert('hii');}

  $("div.set-prod > a").on("click", function(){   
    if ($(this).hasClass("active")) {
      $(this).removeClass("active");
      $(this)
        .siblings("div.content-prod")
        .slideUp(200);
      $("div.set-prod > a svg")
        .removeClass("fa-minus")
        .addClass("fa-plus");
    } else {
      $("div.set-prod > a svg")
        .removeClass("fa-minus")
        .addClass("fa-plus");
      $(this)
        .find("svg")
        .removeClass("fa-plus")
        .addClass("fa-minus");
      $("div.set-prod > a").removeClass("active");      
      $(this).addClass("active");
      $("div.content-prod").slideUp(500);
      $(this)
        .siblings("div.content-prod")
        .slideDown(500);
    }
  });
});
</script>

