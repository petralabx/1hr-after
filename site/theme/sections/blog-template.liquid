<div class="lab-series blog-bg blogs">
   <div class="page-width">
      
      <!--sanket-code-->
  <div class="page-top-blog-section">
          <div class="blog-page-title-box">
              <div class="blog-1hra-title">
                    <div class="lab-series-ttl">
                        <h2>1HR <span class="h-line"></span>A <sup>TM</sup></h2>           
                    </div>
              </div>
              <div class="blog-page-title-details">
                  <h4>PERIODIC INSIGHTS INTO THE PROCESS AND PERSPECTIVE OF 1HR-A</h4>
              </div>
          </div>
 
  </div>


  
     <div class="populer-wrap">
       
       <div class="content-box">
          <ul class="blog-list-view latest" style="">
            
         {% for article in blog.articles %}
                  	           
          <li>
            <div class="article-listing single-blog-details">               
                <a href="{{ article.url }}">
               {% if article.image %}
     {%- assign img_url = article.image | img_url: 'master'  -%}
                
    <img src="{{ img_url }}" id='image123eee' class='lazyload'/>    
    {% endif %}              
               {% if section.settings.blog_show_author %}
               <!--<span class="article__author">{{ 'blogs.article.by_author' | t: author: article.author }}</span>-->
               {% endif %}
               {% if section.settings.blog_show_date %}
               <span class="article__date testt">
               {{ article.published_at | date: "%B %d, %Y" }}
               </span>
              <h2 class="article__title h3"><a href="{{ article.url }}">{{ article.title }}</a></h2>
              <a href="{{ article.url }}" class="read-more-blog">Read more</a>
               {% endif %}
               <noscript>
                  <p>
                    
                     {{ article | img_url: '455x300', scale: 2 | img_tag: article.title }}
                     
                  </p>
               </noscript>               
                </a>
              
            </div>
         </li>
            
         {% endfor %}
        
      </ul>
       
      
       </div>
     </div>
      <!--sanket-code-->
   </div>


{%- if paginate.pages > 1 -%}
{% include 'pagination', paginate: paginate %}
{%- endif -%}
{% endpaginate %}
 {% endif %}
