<div class="custom-feature-row">
  {% if section.settings.image != blank %}
    <div class="custom-feature-row__bg" style="background-image:url({{ section.settings.image | img_url: '2000x' }});">
      <div class="custom-feature-row__overlay">
        <div class="custom-feature-row__content">
          {% if section.settings.title != blank %}
            <h2 class="h3">{{ section.settings.title | escape }}</h2>
          {% endif %}
          {% if section.settings.text != blank %}
            <div class="rte rte-setting featured-row__subtext">{{ section.settings.text }}</div>
          {% endif %}
          {% if section.settings.button_label != blank and section.settings.button_link != blank %}
            {%- capture ariaLabel -%}
              {{- section.settings.button_label -}}
              {%- if section.settings.button_link.type == 'frontpage_link' -%}
                : {{ 'homepage.general.title' | t -}}
              {%- elsif section.settings.button_link.type == 'catalog_link' -%}
                : {{ 'collections.catalog.title' | t -}}
              {%- elsif section.settings.button_link.object.title -%}
                : {{ section.settings.button_link.object.title -}}
              {%- endif -%}
            {%- endcapture -%}

            <a href="{{ section.settings.button_link }}"
              class="btn custom-feature-btn"
              aria-label="{{ ariaLabel }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
  {% endif %}
</div>

{% schema %}
{
  "name": "Image with centered text",
  "class": "index-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your heading here"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Add your description text here.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Image with centered text",
      "category": "Image"
    }
  ]
}
{% endschema %}

{% stylesheet %}
.custom-feature-row {
  width: 100%;
  margin: 0;
  padding: 0;
}

.custom-feature-row__bg {
  position: relative;
  width: 100%;
  min-height: 100vh; /* full screen */
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
}

.custom-feature-row__overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;   /* vertical center */
  justify-content: center; /* horizontal center */
  text-align: center;
  background: rgba(0,0,0,0.4); /* optional overlay */
}

.custom-feature-row__content {
  color: #fff !important;
  max-width: 800px;
  padding: 20px;
}

/* Force all text inside content to white */
.custom-feature-row__content h2,
.custom-feature-row__content p,
.custom-feature-row__content a,
.custom-feature-row__content div,
.custom-feature-row__content span {
  color: #fff !important;
}

/* Button style */
.custom-feature-btn {
  background: #fff;
  color: #000 !important;
  padding: 12px 28px;
  border-radius: 4px;
  display: inline-block;
  margin-top: 20px;
  text-decoration: none;
  font-weight: 600;
  transition: all 0.3s ease;
}

.custom-feature-btn:hover {
  background: transparent;
  color: #fff !important;
  border: 2px solid #fff;
}
{% endstylesheet %}