{% comment %}
  Email signup bar. Heading and text come from the parent section so they can be edited in the theme editor.
{% endcomment %}
{%- assign oha_heading = heading | default: 'Join the 1HR-A list' -%}
{%- assign oha_text = text | default: 'Training tips, new drops and early access, in your inbox about twice a month.' -%}
{%- assign oha_form_id = form_id | default: 'oha-email-signup' -%}
<div class="oha-signup">
  <div class="lab-series">
    <div class="page-width home">
      <div class="lab-subscribe">
        <div class="left">
          <h2>{{ oha_heading | escape }}</h2>
          <p>{{ oha_text | escape }}</p>
        </div>
        <div class="right">
          {% form 'customer', id: oha_form_id, novalidate: 'novalidate', class: 'contact-form' %}
            {%- if form.posted_successfully? -%}
              <p class="form-message form-message--success" tabindex="-1" data-form-status>
                {{ 'general.newsletter_form.confirmation' | t }}
              </p>
            {%- endif -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="input-group {% if form.errors %} input-group--error{% endif %}">
              <input type="email"
                name="contact[email]"
                id="{{ oha_form_id }}-email"
                class="input-group__field{% if form.errors %} input--error{% endif %}"
                value="{{ form.email }}"
                placeholder="Email address"
                aria-label="Email address"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="{{ oha_form_id }}-email-error"
                  data-form-status
                {% endif %}
              >
              <span class="input-group__btn">
                <button type="submit" class="btn" name="commit">
                  <span>{{ 'general.newsletter_form.submit' | t }}</span>
                </button>
              </span>
            </div>
            {%- if form.errors contains 'email' -%}
              <span id="{{ oha_form_id }}-email-error" class="input-error-message">
                <span class="visually-hidden">{{ 'general.accessibility.error' | t }} </span>
                {% include 'icon-error' %}
                <span>{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}.</span>
              </span>
            {%- endif -%}
          {% endform %}
        </div>
      </div>
    </div>
  </div>
</div>
